# Normalize line endings across Mac / Windows / Linux
* text=auto eol=lf

# Always LF for shell scripts and SQL (run on the VPS)
*.sh    text eol=lf
*.sql   text eol=lf

# PowerShell stays CRLF
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.mp3    binary
*.wav    binary
*.ogg    binary
*.woff   binary
*.woff2  binary
