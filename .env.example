# BMU AI Academic Advisor - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Database Configuration
# MAMP defaults differ by OS: 8889 on macOS, 3306 on Windows. Pick the one that matches your install.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bmu_academic_advisor

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ===========================================
# AI Configuration - DeepSeek (Primary & Only Provider)
# ===========================================
# Get your API key at: https://platform.deepseek.com/
# DeepSeek is available to ALL users (100 prompts/month for regular, unlimited for admin)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# AI Model Settings
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ===========================================
# RAG & Embeddings (Ollama for local embeddings only)
# ===========================================
ENABLE_RAG=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# VC large document handling
VC_SECTION_SUMMARY_THRESHOLD=20000
VC_SECTION_SUMMARY_MAX=12
VC_SECTION_SUMMARY_CHARS=6000
VC_DOCUMENT_CHAT_TOPK=5
VC_DOCUMENT_CHAT_MAX_TOPK=12
VC_DOCUMENT_CHAT_MAX_CONTEXT_CHARS=12000
VC_REPORT_CHAT_TOPK=5
VC_REPORT_CHAT_MAX_TOPK=12
VC_REPORT_CHAT_MAX_CONTEXT_CHARS=12000
VC_CHAT_HISTORY_MAX_CHARS=2400
VC_CHAT_HISTORY_SNIPPET_CHARS=800
VC_CHAT_SUMMARY_MAX_CHARS=1200
VC_CHAT_KEY_POINT_MAX_CHARS=240

# Ollama is used ONLY for embeddings (not for chat)
# Keep Ollama private in production: use localhost on the VPS
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text outputs 768-dim vectors
EMBEDDING_DIM=768

# ===========================================
# Voice (free-first stack for student-scale traffic)
# ===========================================
ENABLE_VOICE_RESPONSES=true
TTS_LANGUAGE=en-NG

# --- Text-to-speech (advisor voice) ---
# Primary provider. "ttsmaker" uses your TTSMaker key; "browser" falls back to
# the student's built-in speechSynthesis (zero server load, OS voices).
TTS_PROVIDER=ttsmaker

# TTSMaker (https://ttsmaker.com) — free tier, no per-request cost in normal use
TTSMAKER_TTS_ENABLED=1
TTSMAKER_TTS_API_KEY=your_ttsmaker_api_key
# Browse voice IDs at https://ttsmaker.com/voice-list
TTSMAKER_TTS_VOICE_LABEL=Male Alex Canadian
TTSMAKER_TTS_VOICE_ID=2522

# Lip-sync: we compute mouth shapes from the audio waveform on the client
# using the Web Audio API (works with any TTS). Set to false to disable.
ENABLE_AMPLITUDE_LIPSYNC=true

# --- Speech-to-text (student mic) ---
# Browser Web Speech API is used by default on the client (free, on-device).
# When unsupported (e.g. Firefox) or when audio is uploaded, the server falls
# back to Groq Whisper (free tier, ~14k requests/day).
STT_PROVIDER=groq            # groq | whisper-local | disabled
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo

# Privacy: do not retain raw audio after transcription
STT_RETAIN_AUDIO=false

# --- Optional: Azure (kept for advanced lip-sync via visemes) ---
# Leave blank to skip Azure. Set the key+region to enable phoneme-accurate visemes.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-NG-EzinneNeural

# ===========================================
# Email Configuration (password reset)
# ===========================================
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@bmu.edu.ng
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=tls
# Set to false if your SMTP server has a self-signed or untrusted certificate
SMTP_REJECT_UNAUTHORIZED=true
FROM_NAME=BMU AI Assistant
FROM_EMAIL=no-reply@bmu.edu.ng

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ===========================================
# University Settings
# ===========================================
UNIVERSITY_DOMAIN=bmu.edu.ng

# ===========================================
# Academic Advisor (new)
# ===========================================
# Persona shown to students and used in LLM system prompt
ADVISOR_NAME=Dr. Tari
ADVISOR_TITLE=BMU Academic Advisor
# Email that receives escalations when the AI can't help / student requests a human
ADVISOR_ESCALATION_EMAIL=advisor@bmu.edu.ng
# Max characters of the spoken (short) answer; the typewriter shows the full markdown
ADVISOR_SPEECH_MAX_CHARS=600
# Cap on the number of conversation turns kept in LLM context (older turns are summarised out)
ADVISOR_HISTORY_TURNS=8
