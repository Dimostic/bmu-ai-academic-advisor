{
  "name": "bmu-ai-academic-advisor",
  "version": "0.1.0",
  "description": "BMU AI Academic Advisor - interactive talking advisor for Bayelsa Medical University students (academics + support, voice + text)",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "train": "node server/services/trainModel.js",
    "setup-db": "node server/scripts/setupDatabase.js",
    "ingest": "node server/scripts/ingestSources.js",
    "ingest:extract": "node server/scripts/ingestSources.js --extract-only",
    "ingest:embed": "node server/scripts/ingestSources.js --embed-only",
    "ingest:status": "node server/scripts/ingestSources.js --status",
    "ingest:normalise": "node server/scripts/ingestSources.js --normalise",
    "extract:ccmas": "node server/scripts/extractCcmasProgrammeSections.js",
    "test": "node server/scripts/smokeTest.js",
    "bench:advisor": "node server/scripts/evaluateAdvisorBenchmarks.js",
    "seed:authoritative-cache": "node server/scripts/seedAuthoritativeCache.js"
  },
  "keywords": [
    "ai",
    "chatbot",
    "university",
    "whatsapp",
    "bmu"
  ],
  "author": "BMU Development Team",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.80",
    "@langchain/ollama": "^0.1.6",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.37",
    "mammoth": "^1.6.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.34.0",
    "msedge-tts": "^2.0.5",
    "multer": "^1.4.5-lts.1",
    "mysql": "^2.18.1",
    "natural": "^6.10.4",
    "nodemailer": "^6.9.8",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "faiss-node": "^0.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
